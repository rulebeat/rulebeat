{
  "name": "rulebeat",
  "version": "0.7.0",
  "private": true,
  "description": "RuleBeat is an open-source, self-hosted Azure governance tool. It runs the rules you create and customize on a schedule and tracks every finding until it is fixed.",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build:core": "tsc --build packages/core",
    "dev": "npm run build:core && npm run dev --workspace=packages/web",
    "typecheck": "npm run build:core && npm run typecheck --workspace=packages/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:core": "vitest run --project core",
    "test:web": "vitest run --project web",
    "test:coverage": "vitest run --coverage",
    "sync-pack": "tsx scripts/sync-pack.ts",
    "release": "node scripts/release.mjs",
    "test:release-version": "node --test scripts/verify-release-version.test.mjs",
    "test:release-changelog": "node --test scripts/release-bump-changelog.test.mjs",
    "test:release-pin": "node --test scripts/release-pin-image-tags.test.mjs",
    "test:release-candidate": "node --test scripts/check-release-candidate.test.mjs",
    "test:changelog-structure": "node --test scripts/check-changelog-structure.test.mjs",
    "test:dependency-notes": "node --test scripts/release-dependency-notes.test.mjs",
    "test:changelog-gate": "node --test scripts/check-changelog-entry.test.mjs",
    "test:pr-context": "node --test scripts/resolve-pr-context.test.mjs",
    "test:builder-deps": "node --test scripts/verify-builder-deps.test.mjs",
    "test:fetch-main-ref": "node --test scripts/fetch-main-ref.test.mjs",
    "generate-demo": "npm run build:core && npm run generate-demo --workspace=packages/web",
    "secrets-scan": "gitleaks detect --source . --log-opts=--all"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "js-yaml": "^5.4.2",
    "rimraf": "^6.1.0",
    "tsx": "^4.23.15",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.1"
  }
}
