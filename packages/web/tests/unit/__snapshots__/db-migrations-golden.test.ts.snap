exports[`TS-25 · the upgrade produces a recorded, stable result > 25-02 · current upgrades to a known state 1`] = `
"== SCHEMA ==
table audit_log
  id TEXT PK(1)
  actor_id TEXT NOT NULL
  actor_email TEXT NOT NULL
  action TEXT NOT NULL
  entity_type TEXT
  entity_id TEXT
  summary TEXT NOT NULL
  details TEXT
  occurred_at TEXT NOT NULL
table azure_credentials
  id TEXT PK(1)
  name TEXT NOT NULL
  tenant_id TEXT NOT NULL
  client_id TEXT NOT NULL
  client_secret TEXT NOT NULL
  is_active INTEGER NOT NULL DEFAULT 1
  last_verified_at TEXT
  last_verified_subscriptions INTEGER
  created_at TEXT NOT NULL
  updated_at TEXT NOT NULL
  created_by TEXT
table categories
  id TEXT PK(1)
  label TEXT NOT NULL
  color TEXT
  icon TEXT
  sort_order INTEGER NOT NULL DEFAULT 0
  is_builtin INTEGER NOT NULL DEFAULT 0
  is_special INTEGER NOT NULL DEFAULT 0
  created_at TEXT NOT NULL
table dashboards
  id TEXT PK(1)
  name TEXT NOT NULL
  description TEXT
  config TEXT NOT NULL
  is_default INTEGER NOT NULL DEFAULT 0
  created_at TEXT NOT NULL
table finding_events
  id TEXT PK(1)
  fingerprint TEXT NOT NULL
  rule_id TEXT NOT NULL
  category TEXT NOT NULL
  scan_id TEXT NOT NULL
  type TEXT NOT NULL
  occurred_at TEXT NOT NULL
table findings
  fingerprint TEXT PK(1)
  rule_id TEXT NOT NULL
  category TEXT NOT NULL
  severity TEXT NOT NULL
  kind TEXT NOT NULL DEFAULT 'state'
  dimension_key TEXT
  resource_id TEXT
  resource_type TEXT
  resource_name TEXT
  subscription_id TEXT NOT NULL
  resource_group TEXT
  location TEXT
  title TEXT NOT NULL
  description TEXT NOT NULL DEFAULT ''
  recommendation TEXT NOT NULL DEFAULT ''
  remediation_steps TEXT NOT NULL DEFAULT '[]'
  evidence TEXT NOT NULL DEFAULT '{}'
  azure_portal_link TEXT
  status TEXT NOT NULL DEFAULT 'active'
  first_seen_at TEXT NOT NULL
  last_seen_at TEXT NOT NULL
  resolved_at TEXT
  last_scan_id TEXT
  times_seen INTEGER NOT NULL DEFAULT 1
  deadline TEXT
  group_value TEXT
table local_accounts
  user_id TEXT PK(1)
  password_hash TEXT NOT NULL
  must_change_password INTEGER NOT NULL DEFAULT 0
  failed_attempts INTEGER NOT NULL DEFAULT 0
  locked_until TEXT
  password_updated_at TEXT
  created_at TEXT NOT NULL
table log_analytics_workspaces
  id TEXT PK(1)
  name TEXT NOT NULL
  workspace_id TEXT NOT NULL
  is_active INTEGER NOT NULL DEFAULT 1
  last_verified_at TEXT
  created_at TEXT NOT NULL
  updated_at TEXT NOT NULL
  created_by TEXT
table meta
  key TEXT PK(1)
  value TEXT NOT NULL
table notification_channels
  id TEXT PK(1)
  name TEXT NOT NULL
  type TEXT NOT NULL
  url TEXT NOT NULL
  created_at TEXT NOT NULL
  updated_at TEXT NOT NULL
  last_notified_at TEXT
  last_error TEXT
  config TEXT
  include_advisories INTEGER NOT NULL DEFAULT 0
table notification_deliveries
  id TEXT PK(1)
  channel_id TEXT NOT NULL
  schedule_id TEXT NOT NULL
  run_id TEXT NOT NULL
  occurred_at TEXT NOT NULL
  ok INTEGER NOT NULL
  attempts INTEGER NOT NULL DEFAULT 1
  http_status INTEGER
  error TEXT
  findings_count INTEGER NOT NULL DEFAULT 0
table posture_snapshots
  category TEXT NOT NULL PK(1)
  subscription_id TEXT NOT NULL PK(2) DEFAULT ''
  date TEXT NOT NULL PK(3)
  posture_pct INTEGER
  passing_rules INTEGER NOT NULL DEFAULT 0
  total_rules INTEGER NOT NULL DEFAULT 0
  active_findings INTEGER NOT NULL DEFAULT 0
  severity_counts TEXT NOT NULL DEFAULT '{}'
  updated_at TEXT NOT NULL
  unknown_rules INTEGER NOT NULL DEFAULT 0
  activity_rule_count INTEGER NOT NULL DEFAULT 0
  formula_version INTEGER NOT NULL DEFAULT 1
table query_runs
  id TEXT PK(1)
  query_backend TEXT NOT NULL
  scope TEXT
  raw_kql TEXT
  graph_query TEXT
  logs_query TEXT
  count INTEGER NOT NULL
  capped INTEGER NOT NULL
  truncated INTEGER NOT NULL
  saved_query_id TEXT
  owner_id TEXT NOT NULL
  ran_at TEXT NOT NULL
table resource_types_cache
  id INTEGER PK(1)
  types TEXT NOT NULL
  cached_at TEXT NOT NULL
table rule_versions
  rule_id TEXT NOT NULL PK(1)
  version TEXT NOT NULL PK(2)
  sort_key TEXT NOT NULL
  release_note TEXT NOT NULL
  definition TEXT NOT NULL
  upstream_ref TEXT
  first_seen_at TEXT NOT NULL
table rules
  id TEXT PK(1)
  name TEXT NOT NULL
  description TEXT NOT NULL
  category TEXT NOT NULL
  severity TEXT NOT NULL
  enabled INTEGER NOT NULL DEFAULT 1
  scope TEXT NOT NULL
  resource_types TEXT NOT NULL
  filter TEXT
  conditions TEXT NOT NULL DEFAULT '[]'
  project_columns TEXT
  raw_kql TEXT
  rules_operator TEXT
  type TEXT NOT NULL DEFAULT 'custom'
  pack TEXT
  group_name TEXT
  visual_query TEXT
  tags TEXT
  query_backend TEXT NOT NULL DEFAULT 'resource-graph'
  kind TEXT NOT NULL DEFAULT 'state'
  last_run_status TEXT
  last_run_at TEXT
  graph_query TEXT
  logs_query TEXT
  version TEXT
  retired_at TEXT
  origin_rule_id TEXT
  origin_version TEXT
  deadline_field TEXT
  group_field TEXT
  condition_groups TEXT
table saved_queries
  id TEXT PK(1)
  name TEXT NOT NULL
  query_backend TEXT NOT NULL
  scope TEXT
  visual_query TEXT
  raw_kql TEXT
  graph_query TEXT
  logs_query TEXT
  visibility TEXT NOT NULL DEFAULT 'private'
  owner_id TEXT NOT NULL
  owner_email TEXT NOT NULL
  created_at TEXT NOT NULL
  updated_at TEXT NOT NULL
  last_run_at TEXT
table scans
  id TEXT PK(1)
  module TEXT NOT NULL
  started_at TEXT NOT NULL
  finished_at TEXT NOT NULL
  duration_ms INTEGER NOT NULL
  subscriptions_scanned TEXT NOT NULL
  findings TEXT NOT NULL
  counts TEXT NOT NULL
  triggered_by TEXT NOT NULL DEFAULT 'manual'
  schedule_id TEXT
  coverage TEXT NOT NULL DEFAULT 'complete'
  incomplete_rules TEXT NOT NULL DEFAULT '[]'
  total_rules INTEGER NOT NULL DEFAULT 0
  total_policies INTEGER NOT NULL DEFAULT 0
  run_id TEXT
table schedule_notification_channels
  schedule_id TEXT NOT NULL PK(1)
  channel_id TEXT NOT NULL PK(2)
  min_severity TEXT NOT NULL DEFAULT 'high'
  category_ids TEXT
  subscription_ids TEXT
table schedule_runs
  id TEXT PK(1)
  schedule_id TEXT NOT NULL
  started_at TEXT NOT NULL
  finished_at TEXT
  status TEXT NOT NULL
  categories TEXT NOT NULL
  total_findings INTEGER NOT NULL DEFAULT 0
  new_findings INTEGER NOT NULL DEFAULT 0
  new_finding_fingerprints TEXT
  error TEXT
  duration_ms INTEGER
  triggered_by TEXT NOT NULL DEFAULT 'schedule'
  target_type TEXT
  target_values TEXT
  notify_status TEXT NOT NULL DEFAULT 'none'
  notify_claimed_at TEXT
  heartbeat_at TEXT
  owner_id TEXT
table schedules
  id TEXT PK(1)
  name TEXT NOT NULL
  enabled INTEGER NOT NULL DEFAULT 1
  next_run_at TEXT
  last_run_at TEXT
  created_at TEXT NOT NULL
  updated_at TEXT NOT NULL
  target_type TEXT NOT NULL DEFAULT 'all'
  target_values TEXT NOT NULL DEFAULT '[]'
  recurrence_type TEXT NOT NULL DEFAULT 'once'
  interval INTEGER NOT NULL DEFAULT 1
  days_of_week TEXT
  day_of_month INTEGER
  start_at TEXT NOT NULL DEFAULT ''
  end_type TEXT NOT NULL DEFAULT 'never'
  end_date TEXT
table schema_cache
  resource_type TEXT PK(1)
  fields TEXT NOT NULL
  cached_at TEXT NOT NULL
  field_count INTEGER NOT NULL
table sso_providers
  id TEXT PK(1)
  provider TEXT NOT NULL
  tenant_id TEXT NOT NULL
  client_id TEXT NOT NULL
  client_secret TEXT NOT NULL
  is_active INTEGER NOT NULL DEFAULT 0
  last_verified_at TEXT
  created_at TEXT NOT NULL
  updated_at TEXT NOT NULL
  created_by TEXT
table suppressions
  id TEXT PK(1)
  fingerprint TEXT NOT NULL
  resource_id TEXT
  reason TEXT NOT NULL
  suppressed_at TEXT NOT NULL
  expires_at TEXT
table users
  id TEXT PK(1)
  email TEXT NOT NULL
  oid TEXT
  name TEXT
  role TEXT NOT NULL DEFAULT 'viewer'
  scope TEXT
  session_epoch INTEGER NOT NULL DEFAULT 0
  created_at TEXT NOT NULL
  last_seen_at TEXT
index idx_audit_log_occurred on audit_log
index idx_finding_events_time on finding_events
index idx_findings_category_status on findings
index idx_findings_rule on findings
index idx_notification_deliveries_channel on notification_deliveries
index idx_query_runs_owner on query_runs
index idx_saved_queries_owner on saved_queries
index idx_scans_module_started on scans
index idx_schedule_runs_schedule on schedule_runs
index idx_snapshots_date on posture_snapshots
index idx_users_oid on users

