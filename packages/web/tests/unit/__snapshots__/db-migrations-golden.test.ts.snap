\\",\\"title\\":\\"Top Offending Resources\\",\\"x\\":0,\\"y\\":26,\\"w\\":6,\\"h\\":6,\\"config\\":{\\"limit\\":8}},{\\"id\\":\\"w14\\",\\"type\\":\\"coverage-freshness\\",\\"title\\":\\"Scan Coverage\\",\\"x\\":6,\\"y\\":26,\\"w\\":6,\\"h\\":6,\\"config\\":{}},{\\"id\\":\\"w15\\",\\"type\\":\\"new-vs-fixed\\",\\"title\\":\\"New vs. Fixed\\",\\"x\\":0,\\"y\\":32,\\"w\\":12,\\"h\\":5,\\"config\\":{\\"period\\":\\"30d\\"}}]}","created_at":"<TS>","description":"Overall governance posture across all categories","id":"default","is_default":1,"name":"Overview"}
