rules {"category":"compliance","condition_groups":"[{\\"id\\":\\"g1\\",\\"conditions\\":[{\\"field\\":\\"location\\",\\"operator\\":\\"equals\\",\\"value\\":\\"westeurope\\"}]}]","conditions":"[{\\"field\\":\\"name\\",\\"operator\\":\\"startsWith\\",\\"value\\":\\"x\\"}]","deadline_field":null,"description":"Anything still running in westeurope.","enabled":1,"filter":null,"graph_query":null,"group_field":null,"group_name":"Production","id":"<UUID>","kind":"state","last_run_at":null,"last_run_status":null,"logs_query":null,"name":"VMs in the retired region","origin_rule_id":null,"origin_version":null,"pack":null,"project_columns":null,"query_backend":"resource-graph","raw_kql":"Resources\\n| where type =~ 'microsoft.compute/virtualmachines'\\n| where location =~ 'westeurope'\\n| project id, name, type, location, resourceGroup, subscriptionId, tags","resource_types":"[\\"*\\"]","retired_at":null,"rules_operator":null,"scope":"{\\"level\\":\\"resource\\"}","severity":"medium","tags":"[\\"Production\\"]","type":"custom","version":null,"visual_query":null}
rules {"category":"compliance","condition_groups":null,"conditions":"[]","deadline_field":null,"description":"Resources missing the 'CostCenter' tag cannot be attributed to a cost center for chargeback. Edit this rule's KQL to match your tag name.","enabled":0,"filter":null,"graph_query":null,"group_field":null,"group_name":null,"id":"<UUID>","kind":"state","last_run_at":null,"last_run_status":null,"logs_query":null,"name":"Missing CostCenter Tag","origin_rule_id":null,"origin_version":null,"pack":"rulebeat-core","project_columns":null,"query_backend":"resource-graph","raw_kql":"Resources\\n| where type !in~ (\\n    'microsoft.network/virtualnetworks/subnets',\\n    'microsoft.network/networksecuritygroups/securityrules',\\n    'microsoft.network/routetables/routes',\\n    'microsoft.compute/virtualmachinescalesets/virtualmachines',\\n    'microsoft.resources/deployments',\\n    'microsoft.resources/deploymentscripts'\\n  )\\n| where isempty(tostring(tags['CostCenter'])) or isnull(tags['CostCenter'])\\n| project id, name, type, location, resourceGroup, subscriptionId","resource_types":"[]","retired_at":null,"rules_operator":null,"scope":"{\\"level\\":\\"resource\\"}","severity":"medium","tags":null,"type":"builtin","version":"1.0.0","visual_query":null}
